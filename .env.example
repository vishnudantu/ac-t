# Copy to .env and replace every required placeholder before using Compose.
# Never commit .env or credentials.

POSTGRES_DB=aca_ticketops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql://postgres:replace-with-a-unique-database-password@postgres:5432/aca_ticketops?schema=public

# Required authentication secret (openssl rand -base64 48).
JWT_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
ALLOW_EPHEMERAL_DEV_AUTH=false

# App binding. Keep private behind a TLS reverse proxy in production.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
LOG_LEVEL=info

# Local-only PostgreSQL access; remove or change in production.
POSTGRES_HOST_PORT=127.0.0.1:55432

# First-run seeding only, for office@andhracricket.com. Unset after account creation.
ADMIN_INITIAL_PASSWORD=

# Notification channels (all off by default). Enable only after configuring the provider.
ENABLE_EMAIL=false
ENABLE_SMS=false
ENABLE_WHATSAPP=false

# Email via SMTP (used when ENABLE_EMAIL=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS and WhatsApp via Twilio (used when ENABLE_SMS/ENABLE_WHATSAPP=true).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
