# ACA TicketOps - Example Environment Configuration
# Copy this file to .env for local development and replace the placeholders.
# Never commit the real .env file or use these placeholder secrets in production.

# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/aca_ticketops?schema=public"

# ============================================
# Authentication
# Generate independent, cryptographically random secrets for real deployments.
# Each secret should be at least 32 characters long.
# ============================================
AUTH_SECRET="your-super-secret-auth-key-min-32-chars"
JWT_SECRET="your-jwt-secret-key-min-32-chars"
SESSION_PASSWORD="your-session-password-min-32-chars"

# ============================================
# Redis - BullMQ background jobs
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# File Storage - S3 compatible
# ============================================
S3_ENDPOINT="https://s3.example.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET="aca-ticketops"
S3_REGION="auto"

# ============================================
# Email - SMTP
# ============================================
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="ACA TicketOps <noreply@aca.example.com>"

# ============================================
# SMS - Twilio
# ============================================
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+1234567890"

# ============================================
# WhatsApp Business - Meta
# ============================================
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"
WHATSAPP_VERIFY_TOKEN="your-verify-token"

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ACA TicketOps"
NEXT_PUBLIC_ORG_NAME="Andhra Cricket Association"
TIMEZONE="Asia/Kolkata"

# ============================================
# Feature Flags
# Optional integrations stay disabled until valid credentials are configured.
# ============================================
ENABLE_MFA=true
ENABLE_WHATSAPP=false
ENABLE_SMS=false
ENABLE_EMAIL=false
